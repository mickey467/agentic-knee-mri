{
  "name": "Agentic Knee MRI",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "KneeAI app", "onAutoForward": "openPreview" },
    "8000": { "label": "API", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash scripts/codespaces-setup.sh",
  "postStartCommand": "bash scripts/codespaces-start.sh",
  "remoteUser": "vscode"
}
